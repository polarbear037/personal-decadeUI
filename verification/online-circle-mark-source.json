        "DATA_RAOSHE"
      ]
    },
    {
      "markid": 14,
      "color": "38283c",
      "lightnum": 4,
      "text": "忍",
      "tipstitle": "忍戒",
      "tipstext": "准备阶段，若你有4枚此标记则觉醒。<br>觉醒后可移除此标记以发动极略。<br><br><font color='#a61ba9'>“终于，结束了吗？不，这是新的开始…… ”</font>",
      "stateConstants": [
        "DATA_RENJIE"
      ]
    },
    {
      "markid": 16,
      "color": "403032",
      "text": "梦",
      "tipstitle": "梦魇",
      "tipstext": "拥有武魂技能的角色死亡时，梦魇标记最多的角色判定。结果若不为桃或桃园结义，则一同死亡。<br><br><font color='#a61ba9'>“他回来了，带着一身新装备——鬼龙斩月刀和梦魇赤兔马。”</font>",
      "stateConstants": [
        "DATA_MENGYAN"
