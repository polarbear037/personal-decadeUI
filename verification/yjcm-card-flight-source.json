  "findings": [
    {
      "topic": "seat-transfer-curve",
      "evidence": "MoveCardController.defaultAction 0.11 PC6 TEST r4 C1 / PC7 JMP到PC73：srcSeatIsSelf为true跳过首段。false分支PC37..46: EaseSineIn(moveTo(13/30))；true分支PC112..121: EaseSineIn(moveTo(18/30))。与同缓存重建MoveCardController.lua的if not srcSeatIsSelf/elseif srcSeatIsSelf一致。",
      "conclusion": "本人来源的其他座位飞牌为600ms，其余来源433.333ms；位置进度1-cos(pi*t/2)。"
    },
    {
      "topic": "source-seat-branch",
      "evidence": "GameMoveManager 0.0.0 PC397..407把来源座位isSelf作为第五实参传入moveCardToOtherSeat；后者0.12 PC83..89转交defaultAction的r4。",
      "conclusion": "按来源是否本人分流，不按武将名、牌名或目标座次特判。"
    }
  ],
  "local_adaptation": [
    "只接入一将$draw/$gain2/$give飞向其他座位的副本，保留本地坐标、卡牌大小和220ms淡出。",
    "飞行真实onfinish后停留100ms再淡出清理，取消并行墙钟删除计时；暂停或掉帧不能提前删除尚未落位的副本。",
    "本人入手、300ms EaseSineOut处理区、此前用户要求的装备演出及规则层等待不改。",
    "位置121采样关键帧交给WAAPI插值；缩放沿用本地起终点并独立线性，不声称还原官方全部缩放/透明度演出。"
  ],
  "limitations": [
    "当前APK的静态字节码证据，不等于官方客户端动态对照。"
  ]
