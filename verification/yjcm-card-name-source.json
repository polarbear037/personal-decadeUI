  "observations": [
    "SelfCardsArea.reorderAllCards_new: hadSort && isHandCard && count(currentPage)>=15. CardUiNew.setShowCardTag: LEFT_BOTTOM(0,5), z=13, width=126, useShortName=true, selected from cardData.",
    "CardsSortTagNode.refresh (0.5): normal/select assets; scale9 size(width,30), capInsets rect(6,10,1,1); label size22, LEFT_CENTER(3,15); selected RGB(255,233,129), normal RGB(193,174,142).",
